{
  "buildCommand": "pip install -r requirements.txt && cd genx && python manage.py collectstatic --noinput",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=3600, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/genx/genx/wsgi.py"
    }
  ]
}