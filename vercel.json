{
  "buildCommand": "pip install -r requirements.txt && cd genx && python manage.py collectstatic --noinput",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}